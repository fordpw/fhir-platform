server {
    listen {{CLIENT_PORT}};
    server_name {{SERVER_NAME}};
    root {{INSTALL_DIR}}/ui;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy FHIR API to the backend server
    location /fhir/ {
        proxy_pass {{FHIR_SERVER_URL}}/fhir/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Proxy admin / auth API
    location /api/ {
        proxy_pass {{FHIR_SERVER_URL}}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
