# FHIR R4 Platform — application.yaml
# Generated by the installer. Edit manually or re-run the installer to regenerate.

server:
  port: {{SERVER_PORT}}

spring:
  data:
    mongodb:
      uri: {{MONGO_URI}}

app:
  jwt:
    # Set this to a unique random value. Generate one with:
    #   pwsh -Command "[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
    #   openssl rand -base64 32
    secret: {{JWT_SECRET}}
    expiration: 86400000   # 24 hours in ms

  synthea:
    jar-path: {{SYNTHEA_JAR_PATH}}
    output-directory: {{SYNTHEA_OUTPUT_DIR}}
    heap-size: {{SYNTHEA_HEAP_SIZE}}

  cors:
    allowed-origins: {{CORS_ORIGIN}}
