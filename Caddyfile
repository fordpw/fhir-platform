# Caddyfile — production TLS termination and reverse proxy.
# Caddy automatically obtains and renews Let's Encrypt certificates.
# Replace {$DOMAIN} with your domain name, or set the DOMAIN env variable.

# When DOMAIN is a bare IP address, serve HTTP only (no TLS possible).
# When DOMAIN is a real hostname, remove the http:// prefix so Caddy
# automatically obtains a Let's Encrypt certificate.
http://{$DOMAIN} {
    reverse_proxy fhir-admin-ui:80

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options        "DENY"
        Referrer-Policy        "strict-origin-when-cross-origin"
    }

    log {
        output stdout
    }
}
