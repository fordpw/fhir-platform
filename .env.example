# FHIR Platform — environment variable template
# Copy this file to .env and fill in real values. The .env file is gitignored.
#
# Generate a secure value with:
#   pwsh -Command "[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
# or:
#   openssl rand -base64 32

# JWT signing secret for the dev stack (docker-compose.yml).
# Must be unique — do not share with staging or production.
APP_JWT_SECRET=replace-with-a-unique-random-256-bit-base64-value

# JWT signing secret for the staging stack (docker-compose.staging.yml).
# Must differ from APP_JWT_SECRET so tokens cannot be used cross-environment.
STAGING_APP_JWT_SECRET=replace-with-a-different-unique-random-256-bit-base64-value
